[
  {
    "Classification": "iceberg-defaults",
    "Properties": {
      "iceberg.enabled": "true"
    }
  },
  {
    "Classification": "spark-defaults",
    "Properties": {
      "spark.sql.catalog.glue_catalog": "org.apache.iceberg.spark.SparkCatalog",
      "spark.sql.catalog.glue_catalog.warehouse": "s3://ice.bird/",
      "spark.sql.catalog.glue_catalog.catalog-impl": "org.apache.iceberg.aws.glue.GlueCatalog",
      "spark.sql.catalog.glue_catalog.io-impl": "org.apache.iceberg.aws.s3.S3FileIO",
      "spark.sql.extensions": "org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions,org.apache.sedona.sql.SedonaSqlExtensions",
      "spark.jars.packages": "org.apache.sedona:sedona-spark-shaded-3.5_2.12:1.8.0,org.datasyslab:geotools-wrapper:1.8.0-33.1,org.mongodb.spark:mongo-spark-connector_2.12:10.5.0",
      "spark.serializer": "org.apache.spark.serializer.KryoSerializer",
      "spark.kryo.registrator": "org.apache.sedona.core.serde.SedonaKryoRegistrator",
      "spark.sql.session.timeZone": "UTC",
      "spark.sql.adaptive.enabled": "true",
      "spark.sql.sources.partitionOverwriteMode": "dynamic",
      "spark.dynamicAllocation.enabled": "true",
      "spark.shuffle.service.enabled": "true",
      "spark.dynamicAllocation.minExecutors": "1",
      "spark.dynamicAllocation.initialExecutors": "2",
      "spark.dynamicAllocation.maxExecutors": "12",
      "spark.executor.cores": "4",
      "spark.executor.memory": "12g",
      "spark.executor.memoryOverhead": "3g",
      "spark.driver.memory": "4g",
      "spark.driver.memoryOverhead": "1g",
      "spark.scheduler.mode": "FAIR",
      "spark.network.timeout": "600s",
      "spark.executor.heartbeatInterval": "60s"
    }
  },
  {
    "Classification": "livy-conf",
    "Properties": {
      "livy.server.session.timeout": "6h"
    }
  }
]

